{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/pois-entlang-der-route",
        "destination": "/versorgung-ultracycling/",
        "type": 301
      },
      {
        "source": "/en/pois-along-route",
        "destination": "/en/ultracycling-supply/",
        "type": 301
      },
      {
        "source": "/es/pois-en-la-ruta",
        "destination": "/es/avituallamiento-ultracycling/",
        "type": 301
      },
      {
        "source": "/fr/pois-sur-la-route",
        "destination": "/fr/ravitaillement-ultracycling/",
        "type": 301
      },
      {
        "source": "/raca-versorgung",
        "destination": "/versorgung-ultracycling/",
        "type": 301
      },
      {
        "source": "/raca-versorgung/",
        "destination": "/versorgung-ultracycling/",
        "type": 301
      },
      {
        "source": "/en/raca-supply",
        "destination": "/en/ultracycling-supply/",
        "type": 301
      },
      {
        "source": "/en/raca-supply/",
        "destination": "/en/ultracycling-supply/",
        "type": 301
      },
      {
        "source": "/es/raca-avituallamiento",
        "destination": "/es/avituallamiento-ultracycling/",
        "type": 301
      },
      {
        "source": "/es/raca-avituallamiento/",
        "destination": "/es/avituallamiento-ultracycling/",
        "type": 301
      },
      {
        "source": "/fr/raca-ravitaillement",
        "destination": "/fr/ravitaillement-ultracycling/",
        "type": 301
      },
      {
        "source": "/fr/raca-ravitaillement/",
        "destination": "/fr/ravitaillement-ultracycling/",
        "type": 301
      },
      { "source": "/en", "destination": "/en/", "type": 301 },
      { "source": "/es", "destination": "/es/", "type": 301 },
      { "source": "/fr", "destination": "/fr/", "type": 301 },
      { "source": "/versorgung-ultracycling", "destination": "/versorgung-ultracycling/", "type": 301 },
      { "source": "/en/ultracycling-supply", "destination": "/en/ultracycling-supply/", "type": 301 },
      { "source": "/es/avituallamiento-ultracycling", "destination": "/es/avituallamiento-ultracycling/", "type": 301 },
      { "source": "/fr/ravitaillement-ultracycling", "destination": "/fr/ravitaillement-ultracycling/", "type": 301 },
      { "source": "/garmin-course-points-fit", "destination": "/garmin-course-points-fit/", "type": 301 },
      { "source": "/en/garmin-course-points-fit", "destination": "/en/garmin-course-points-fit/", "type": 301 },
      { "source": "/es/garmin-course-points-fit", "destination": "/es/garmin-course-points-fit/", "type": 301 },
      { "source": "/fr/garmin-course-points-fit", "destination": "/fr/garmin-course-points-fit/", "type": 301 },
      { "source": "/datenschutz", "destination": "/datenschutz/", "type": 301 },
      { "source": "/impressum", "destination": "/impressum/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(self)"
          }
        ]
      },
      {
        "source": "/oauth/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/routes/import/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/registerSW.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "/robots.txt",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "/sitemap.xml",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "/llms.txt",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "/favicon.ico",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/favicon.svg",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/favicon-*.png",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/apple-touch-icon.png",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/og-image.jpg",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }]
      },
      {
        "source": "/logo-ultraplaner*.png",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      },
      {
        "source": "/logo-ultraplaner*.webp",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      },
      {
        "source": "/hero-mountains*.webp",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      }
    ],
    "rewrites": [
      {
        "source": "/oauth/wahoo/callback",
        "destination": "/oauth/wahoo/callback.html"
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
