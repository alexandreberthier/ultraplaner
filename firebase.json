{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/pois-entlang-der-route",
        "destination": "/versorgung-ultracycling/",
        "type": 301
      },
      {
        "source": "/en/pois-along-route",
        "destination": "/en/ultracycling-supply/",
        "type": 301
      },
      {
        "source": "/es/pois-en-la-ruta",
        "destination": "/es/avituallamiento-ultracycling/",
        "type": 301
      },
      {
        "source": "/fr/pois-sur-la-route",
        "destination": "/fr/ravitaillement-ultracycling/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(self)"
          }
        ]
      },
      {
        "source": "/oauth/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/routes/import/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/registerSW.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "/robots.txt",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "/sitemap.xml",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "/llms.txt",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "/favicon.ico",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/favicon.svg",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/favicon-*.png",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/apple-touch-icon.png",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      },
      {
        "source": "/og-image.jpg",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }]
      },
      {
        "source": "/logo-ultraplaner.png",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      },
      {
        "source": "/logo-ultraplaner.webp",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      },
      {
        "source": "/hero-mountains.webp",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      },
      {
        "source": "/hero-mountains-1100.webp",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=2592000" }]
      }
    ],
    "rewrites": [
      {
        "source": "/oauth/wahoo/callback",
        "destination": "/oauth/wahoo/callback.html"
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
