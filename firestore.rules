rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tiles/{tileId} {
      allow read: if true;
      allow write: if false;
    }
    // Maps live on Supabase; Firestore maps are legacy — no public writes.
    match /maps/{mapId} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /importProgress/{doc} {
      allow read, write: if false;
    }
  }
}
