VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (POI tiles; anonymous page stats via record_page_session)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Import-Skripte only — never expose to Vite/client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Places API für Öffnungszeiten beim POI-Klick
# Navigation zu Google Maps funktioniert ohne Key.
VITE_GOOGLE_MAPS_API_KEY=

# OpenRouteService / HeiGIT — Radrouting in „Route planen“ (openrouteservice.org)
VITE_ORS_API_KEY=

# Feedback-Formular via Web3Forms (https://web3forms.com — Access Key eintragen)
VITE_WEB3FORMS_ACCESS_KEY=

# Wahoo Cloud API (PKCE — Confidential=No). Client secret never in Vite.
# Portal scopes: routes_read routes_write offline_data user_read
# Callback: https://ultraplaner.com/oauth/wahoo/callback
# Local optional: VITE_WAHOO_REDIRECT_URI=http://localhost:5173/oauth/wahoo/callback
VITE_WAHOO_CLIENT_ID=
# VITE_WAHOO_REDIRECT_URI=

# Firebase Import-Skripte (legacy Overpass / maps admin)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
