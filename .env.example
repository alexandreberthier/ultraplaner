VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (POI tiles)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Import-Skripte only — never expose to Vite/client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Places API für Öffnungszeiten beim POI-Klick
# Navigation zu Google Maps funktioniert ohne Key.
VITE_GOOGLE_MAPS_API_KEY=

# OpenRouteService — Radrouting in „Route planen“ (kostenlos: openrouteservice.org)
VITE_ORS_API_KEY=

# Firebase Import-Skripte (legacy Overpass / maps admin)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
